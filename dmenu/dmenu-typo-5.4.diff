+/* Whether to compare case insensitively (1, default) or not (0). */
+static int typo_ignore_case = 1;
+
+/* Default pattern lengths from which 1 and 2 errors are allowed. */
+#define TYPO_MIN_LEN_1 5
+#define TYPO_MIN_LEN_2 8
