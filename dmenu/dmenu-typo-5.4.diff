From 5943f87581e5dff643d335adaab6c716aac3fb86 Mon Sep 17 00:00:00 2001
From: Maxim Butov <mbutov@gmail.com>
Date: Fri, 13 Nov 2026 15:00:00 +0000
Subject: [PATCH] typo: typo-tolerant matching
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every word of the input also matches ignoring diacritics, so "cafe" finds
"café" and "елка" finds "ёлка"; case follows -i as usual. When the input
is a single word, items that contain it with up to 1 or 2 errors
(restricted Damerau-Levenshtein distance: an inserted, deleted or
substituted character, or two adjacent characters swapped) are listed
after the other matches, fewest errors first: "frefox" finds "firefox".

1 error is allowed from 5 input characters, 2 from 8: typo_min_len_1 and
typo_min_len_2 in config.h. Matching is UTF-8 aware.

Upstream: https://github.com/mbutov/menu-typo
---
 config.def.h |  11 ++
 dmenu.1      |   8 ++
 dmenu.c      |  59 +++++++-
 typo.h       | 394 +++++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 470 insertions(+), 2 deletions(-)
 create mode 100644 typo.h

diff --git a/config.def.h b/config.def.h
index 1edb647..0e1f3aa 100644
--- a/config.def.h
+++ b/config.def.h
@@ -21,3 +21,14 @@ static unsigned int lines      = 0;
  * for example: " /?\"&[]"
  */
 static const char worddelimiters[] = " ";
+
+/*
+ * Typo-tolerant matching. Every word of the input also matches ignoring
+ * diacritics: "cafe" finds "café", "елка" finds "ёлка" (case is ignored
+ * with -i, as usual). When the input is a single word, items that contain
+ * it with up to 1 or 2 errors (Damerau-Levenshtein) are listed after the
+ * exact matches. The input length, in characters, from which 1 and 2
+ * errors are allowed; 0 disables.
+ */
+static unsigned int typo_min_len_1 = 5;
+static unsigned int typo_min_len_2 = 8;
diff --git a/dmenu.1 b/dmenu.1
index 323f93c..1b5282c 100644
--- a/dmenu.1
+++ b/dmenu.1
@@ -31,6 +31,14 @@ stdin.  When the user selects an item and presses Return, their choice is printe
 to stdout and dmenu terminates.  Entering text will narrow the items to those
 matching the tokens in the input.
 .P
+Tokens also match ignoring diacritics, so "cafe" matches "caf\('e".
+When the input is a single word of at least 5 characters, items that contain
+it with one error, or two errors from 8 characters, are listed after the other
+matches, fewest errors first.
+An error is an inserted, deleted or substituted character, or two adjacent
+characters swapped.
+These lengths are set in config.h.
+.P
 .B dmenu_run
 is a script used by
 .IR dwm (1)
diff --git a/dmenu.c b/dmenu.c
index fd49549..6d9ed88 100644
--- a/dmenu.c
+++ b/dmenu.c
@@ -53,6 +53,7 @@ static Drw *drw;
 static Clr *scheme[SchemeLast];
 
 #include "config.h"
+#include "typo.h"
 
 static int (*fstrncmp)(const char *, const char *, size_t) = strncmp;
 static char *(*fstrstr)(const char *, const char *) = strstr;
@@ -226,9 +227,45 @@ grabkeyboard(void)
 	die("cannot grab keyboard");
 }
 
+struct typo_item {
+	struct item *item;
+	int errors;
+	size_t order;
+};
+
+static struct typo_item *typos;
+static size_t ntypos, typocap;
+
+static int
+typo_item_cmp(const void *a, const void *b)
+{
+	const struct typo_item *x = a, *y = b;
+
+	if (x->errors != y->errors)
+		return x->errors - y->errors;
+	return x->order < y->order ? -1 : x->order > y->order;
+}
+
+static void
+addtypo(struct item *item, int errors)
+{
+	if (ntypos == typocap) {
+		typocap = typocap ? 2 * typocap : 64;
+		if (!(typos = realloc(typos, typocap * sizeof *typos)))
+			die("cannot realloc %zu bytes:",
+			    typocap * sizeof *typos);
+	}
+	typos[ntypos].item = item;
+	typos[ntypos].errors = errors;
+	typos[ntypos].order = ntypos;
+	ntypos++;
+}
+
 static void
 match(void)
 {
+	size_t t;
+	int maxerr, err;
 	static char **tokv = NULL;
 	static int tokn = 0;
 
@@ -246,12 +283,26 @@ match(void)
 
 	matches = lprefix = lsubstr = matchend = prefixend = substrend = NULL;
 	textsize = strlen(text) + 1;
+	/* case as with or without -i; diacritics are always ignored */
+	typo_ignore_case = fstrstr == cistrstr;
+	/* a single word may also match with typos */
+	ntypos = 0;
+	maxerr = 0;
+	if (tokc == 1 && typo_min_len_1)
+		maxerr = typo_max_errors(typo_strlen(tokv[0]),
+		    typo_min_len_1, typo_min_len_2 ? typo_min_len_2 : -1u);
 	for (item = items; item && item->text; item++) {
+		/* every word, as is or ignoring case and diacritics */
 		for (i = 0; i < tokc; i++)
-			if (!fstrstr(item->text, tokv[i]))
+			if (!fstrstr(item->text, tokv[i]) &&
+			    !typo_contains(tokv[i], item->text))
 				break;
-		if (i != tokc) /* not all tokens match */
+		if (i != tokc) { /* not all tokens match */
+			if (maxerr && (err = typo_distance(tokv[0],
+			    item->text, maxerr)) <= maxerr)
+				addtypo(item, err);
 			continue;
+		}
 		/* exact matches go first, then prefixes, then substrings */
 		if (!tokc || !fstrncmp(text, item->text, textsize))
 			appenditem(item, &matches, &matchend);
@@ -276,6 +327,10 @@ match(void)
 			matches = lsubstr;
 		matchend = substrend;
 	}
+	/* then matches with typos, fewest errors first */
+	qsort(typos, ntypos, sizeof *typos, typo_item_cmp);
+	for (t = 0; t < ntypos; t++)
+		appenditem(typos[t].item, &matches, &matchend);
 	curr = sel = matches;
 	calcoffsets();
 }
