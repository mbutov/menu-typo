+/* Decodes one UTF-8 character at *s and advances *s. */
+static inline uint32_t
+typo_decode(const char **s)
+{
+	const unsigned char *p = (const unsigned char *)*s;
+	uint32_t c = p[0];
+	int n = 0, i;
+
+	if (c >= 0xf0 && c < 0xf8)
+		n = 3, c &= 0x07;
+	else if (c >= 0xe0)
+		n = 2, c &= 0x0f;
+	else if (c >= 0xc0)
+		n = 1, c &= 0x1f;
+	for (i = 1; i <= n; i++) {
+		/* broken sequence: take the first byte as it is */
+		if ((p[i] & 0xc0) != 0x80) {
+			c = p[0];
+			n = 0;
+			break;
+		}
+		c = (c << 6) | (p[i] & 0x3f);
+	}
+	*s += n + 1;
+	return c;
