+/* Base letter of a letter with diacritics, or c itself. */
+static inline uint32_t
+typo_fold(uint32_t c)
+{
+	size_t lo = 0, hi = sizeof typo_fold_table / sizeof typo_fold_table[0];
+
+	if (c < 0xc0 || c > 0xffff)
+		return c;
+	while (lo < hi) {
+		size_t mid = (lo + hi) / 2;
+
+		if (typo_fold_table[mid][0] == c)
+			return typo_fold_table[mid][1];
+		if (typo_fold_table[mid][0] < c)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return c;
+}
