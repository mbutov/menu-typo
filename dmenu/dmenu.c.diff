+struct typo_item {
+	struct item *item;
+	int errors;
+	size_t order;
+};
+
+static int
+typo_item_cmp(const void *a, const void *b)
+{
+	const struct typo_item *x = a, *y = b;
+
+	if (x->errors != y->errors)
+		return x->errors - y->errors;
+	return x->order < y->order ? -1 : x->order > y->order;
+}
